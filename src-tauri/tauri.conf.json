{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Brainstory",
	"version": "0.1.0",
	"identifier": "ai.brainstory.desktop",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:5173",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../app/frontend/dist"
	},
	"app": {
		"windows": [
			{
				"title": "Brainstory",
				"width": 1200,
				"height": 820,
				"minWidth": 940,
				"minHeight": 600,
				"center": true
			}
		],
	"security": {
				"csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; media-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
			}
	},
	"bundle": {
		"active": true,
		"targets": ["app"],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
