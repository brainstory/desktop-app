{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Brainstory",
  "version": "0.2.0",
  "identifier": "ai.brainstory.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../app/frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Brainstory",
        "width": 1200,
        "height": 820,
        "minWidth": 940,
        "minHeight": 600,
        "center": true,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; media-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYzRDZCQ0UxMUFFODM4ODYKUldTR09PZ2E0YnpXOHlWQTdmR2pWeS9pRUZ5R3VuOGdzRHBWK2JKM1k1ZlFLT1RIK0pwWVdCUlkK",
      "endpoints": [
        "https://github.com/brainstory/desktop-app/releases/latest/download/latest.json"
      ]
    }
  }
}
