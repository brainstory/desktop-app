{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Brainstory",
	"version": "0.1.0",
	"identifier": "ai.brainstory.desktop",
	"build": {
		"beforeDevCommand": "npm run dev",
		"devUrl": "http://localhost:5173",
		"beforeBuildCommand": "npm run build",
		"frontendDist": "../app/frontend/dist"
	},
	"app": {
		"windows": [
			{
				"title": "Brainstory",
				"width": 1200,
				"height": 820,
				"minWidth": 940,
				"minHeight": 600,
				"center": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
