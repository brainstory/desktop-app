---
import BaseHead from "@components/BaseHead.astro";
import Navigation from "@components/global/Navigation";
import Footer from "@components/global/Footer.astro";

const { title, hidePadding, showFooter } = Astro.props;

// The footer is an empty spacer now: 2rem footer + 1rem top padding on
// desktop (2rem footer + 3rem hamburger nav on mobile)
const mainSectionStyle = `min-h-[calc(100vh-5rem)] sm:min-h-[calc(100vh-3rem)] bg-white shadow rounded-lg ${hidePadding ? "" : "p-4"}`
---

<html
	lang="en"
	class="scroll-smooth selection:bg-pink-100 selection:text-black"
>
	<head>
		<BaseHead title={title} />
	</head>

	<body
		class="bg-stone-50 [&_:focus-visible]:ring-4 [&_:focus-visible]:outline-none [&_:focus-visible]:ring-pink-300"
	>
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:top-2 focus:left-2 focus:bg-white focus:ring-4 focus:ring-pink-300 focus:rounded focus:px-3 focus:py-2"
			>Skip to main content</a
		>
		<div class="sm:flex">
			<Navigation client:idle />
			<div class="flex flex-col flex-grow">
				<main id="main" class="p-4 pt-0 sm:pt-4">
					<div
						class:list={mainSectionStyle}
					>
						<slot />
					</div>
				</main>
			</div>
		</div>
		{showFooter && <Footer hasSideNavbar/>}
	</body>
</html>
