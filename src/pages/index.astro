---
import BaseLayout from "@layouts/BaseLayout.astro";
import { STORAGE_KEYS } from "@src/tauri/commands";
---

<BaseLayout title="Brainstory">
	<script is:inline define:vars={{ keys: STORAGE_KEYS }}>
		// First-run onboarding runs before first paint: everyone goes through
		// the guide once, then straight to the dashboard. Inline script = no
		// React mount, no blank flash. define:vars inlines STORAGE_KEYS (the
		// keys storage.ts uses) as `keys`; the script itself stays unbundled.
		(function () {
			var done = false;
			var seen = false;
			try {
				done = localStorage.getItem(keys.gettingStartedDone) !== null;
				seen = localStorage.getItem(keys.indexSeen) !== null;
			} catch (e) {
				/* storage unavailable - default to the dashboard */
			}
			if (!done && !seen) {
				try {
					localStorage.setItem(keys.indexSeen, "true");
				} catch (e) {}
				location.replace("/get-started");
			} else {
				location.replace("/dashboard");
			}
		})();
	</script>
	<div class="flex justify-center items-center min-h-[50vh]">
		<p class="text-stone-500 text-sm">Loading Brainstory...</p>
	</div>
</BaseLayout>
