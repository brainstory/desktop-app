---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
	/** page title; rendered as "<title> | Brainstory" when non-empty */
	title?: string;
}

const { title } = Astro.props;
---

<meta charset="UTF-8" />
<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<meta name="theme-color" content="#ffffff" />

<!--Ionicons (vendored locally - no CDN) -->

<title>{title && `${title} | `} Brainstory</title>

<!-- client-side page transitions: same-origin link clicks swap the
     document without a full reload, so module-scoped store state
     (downloads, ai status, the user) survives navigation -->
<ClientRouter />
