{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"noUnusedLocals": true,
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"paths": {
			"@src/*": ["./src/*"],
			"@components/*": ["./src/components/*"],
			"@helpers/*": ["./src/helpers/*"],
			"@layouts/*": ["./src/layouts/*"],
			"@ds/*": ["./src/components/global/design-system/*"]
		}
	},
	"include": ["./src"]
}
