---
import "../styles/global.css";

const { title } = Astro.props;
---

<meta charset="UTF-8" />
<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="author" content="Brainstory" />

<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<meta name="theme-color" content="#ffffff" />

<meta property="og:title" content="Brainstory" />
<meta property="og:description" content="Find your moments of brilliance without the slump" />
<meta property="og:site_name" content="Brainstory" />
<meta property="og:image" content="/og.png">

<meta name="twitter:title" content="Brainstory">
<meta name="twitter:description" content="Find your moments of brilliance without the slump">
<meta name="twitter:image:src" content="/og.png">
<meta name="twitter:card" content="summary_large_image">

<!--Ionicons (vendored locally - no CDN) -->
<script type="module" src="/vendor/ionicons/ionicons.esm.js"></script>

<title>{title && `${title} | `} Brainstory</title>
