{
	"name": "brainstory",
	"version": "0.4.0",
	"private": true,
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"vendor": "node scripts/vendor-assets.mjs",
		"vendor:check": "node scripts/vendor-assets.mjs --check",
		"dev": "node scripts/vendor-assets.mjs && astro dev --port 5173",
		"start": "astro dev --port 5173",
		"build": "node scripts/vendor-assets.mjs && astro build",
		"preview": "astro preview",
		"astro": "astro",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest",
		"lint": "eslint --max-warnings 0 src scripts",
		"lint:fix": "eslint src scripts --fix",
		"typecheck": "tsc --noEmit && astro check",
		"format": "prettier --write src scripts",
		"format:check": "prettier --check src scripts"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@eslint-react/eslint-plugin": "^5.23.2",
		"@eslint/js": "^10.0.1",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitest/coverage-v8": "^5.0.2",
		"astro": "^7.3.5",
		"eslint": "^10.11.0",
		"eslint-plugin-astro": "^3.2.1",
		"eslint-plugin-jsx-a11y-x": "^0.2.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.12.0",
		"jsdom": "^30.1.1",
		"prettier": "^3.9.9",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.0",
		"vitest": "^5.0.2"
	},
	"dependencies": {
		"@astrojs/react": "^7.0.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@nanostores/react": "^2.0.1",
		"@rive-app/react-canvas": "^4.35.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tauri-apps/api": "^2.12.0",
		"@tauri-apps/plugin-process": "^2.4.0",
		"@tauri-apps/plugin-updater": "^2.13.1",
		"ionicons": "8.1.0",
		"nanostores": "^1.5.4",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-markdown": "^10.1.0",
		"tailwindcss": "^4.3.3"
	}
}
