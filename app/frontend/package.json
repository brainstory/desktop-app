{
	"name": "brainstory",
	"version": "0.0.1",
	"private": true,
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"vendor": "node scripts/vendor-assets.mjs",
		"dev": "node scripts/vendor-assets.mjs && astro dev --port 5173",
		"start": "astro dev --port 5173",
		"build": "node scripts/vendor-assets.mjs && astro build",
		"preview": "astro preview",
		"astro": "astro",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint src scripts",
		"lint:fix": "eslint src scripts --fix",
		"typecheck": "tsc --noEmit && astro check",
		"format": "prettier --write src scripts",
		"format:check": "prettier --check src scripts"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@eslint/js": "^9.39.5",
		"@tailwindcss/vite": "^4.3.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"astro": "^7.3.2",
		"eslint": "^9.39.5",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.12.0",
		"prettier": "^3.9.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vitest": "^5.0.0"
	},
	"dependencies": {
		"@astrojs/react": "^6.0.5",
		"@fontsource-variable/inter": "^5.3.0",
		"@nanostores/react": "^2.0.1",
		"@rive-app/react-canvas": "^4.34.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tauri-apps/api": "^2.11.1",
		"ionicons": "8.1.0",
		"nanostores": "^1.5.3",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-markdown": "^10.1.0",
		"react-select": "^5.10.2",
		"react-timezone-select": "^3.3.3",
		"tailwindcss": "^4.3.3"
	}
}
