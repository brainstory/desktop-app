{
	"name": "brainstory-desktop",
	"version": "0.10.1",
	"packageManager": "pnpm@12.3.4",
	"private": true,
	"license": "GPL-3.0-only",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"dev": "node scripts/vendor-assets.mjs && astro dev --port 5173",
		"start": "astro dev --port 5173",
		"build": "node scripts/vendor-assets.mjs && astro build",
		"preview": "astro preview",
		"astro": "astro",
		"tauri": "tauri",
		"tauri:dev": "tauri dev",
		"tauri:build": "tauri build --bundles app && bash scripts/make-dmg.sh",
		"vendor": "node scripts/vendor-assets.mjs",
		"vendor:check": "node scripts/vendor-assets.mjs --check",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest",
		"types:generate": "cargo test --manifest-path src-tauri/Cargo.toml --lib export_bindings",
		"lint": "eslint --max-warnings 0 src scripts",
		"lint:fix": "eslint src scripts --fix",
		"typecheck": "tsc --noEmit && astro check",
		"format": "prettier --write src scripts",
		"format:check": "prettier --check src scripts"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@eslint-react/eslint-plugin": "^5.28.8",
		"@eslint/js": "^10.0.1",
		"@tailwindcss/vite": "^4.3.5",
		"@tauri-apps/cli": "^2.12.4",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitest/coverage-v8": "^5.1.0",
		"astro": "^7.4.7",
		"eslint": "^10.14.0",
		"eslint-plugin-astro": "^3.2.1",
		"eslint-plugin-import-x": "^4.18.0",
		"eslint-plugin-jsx-a11y-x": "^0.2.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.14.0",
		"jsdom": "^31.0.0",
		"prettier": "^3.9.10",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@astrojs/react": "^7.1.4",
		"@fontsource-variable/inter": "^5.3.0",
		"@nanostores/react": "^2.0.1",
		"@rive-app/react-canvas": "^4.38.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tauri-apps/api": "^2.12.4",
		"@tauri-apps/plugin-process": "^2.4.0",
		"@tauri-apps/plugin-updater": "^2.14.1",
		"ionicons": "8.1.0",
		"nanostores": "^1.5.5",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-markdown": "^10.1.0",
		"tailwindcss": "^4.3.5",
		"valibot": "^1.5.0"
	}
}
